generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  image     String?
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  title     String
  query     String
  persona   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  String   @default("[]")
  simConfig String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  content   String
  sessionId String
  createdAt DateTime @default(now())
}
